    "play-schedule": "play_schedule",
    "fees": "fees",
    "fees-full": "fees_full",
    "come-and-try": "come_and_try",
    "phone": "phone",
    "public-email": "public_email",
    "contact-name": "contact_name",
    "members-link": "members_link",
    "about-paragraph": "about",
    "footer-acknowledgment": "footer_acknowledgment",
    "welcome-paragraph": "welcome",
    "fee-first-visit": "fee_first_visit"
  },
  "image_map": {
    "site-logo": "logo",
    "tile-photo-main": "photo_clubhouse",
    "tile-photo-lawn": "photo_players",
    "tile-photo-closeup": "photo_closeup"
  },
  "optional_sections": {
